layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float kInfinity = 3.402823466e+38;
const float kEpsilon = 1.0e-4;
const uint kMaxDebugEvents = 256u;

struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 color;
};

struct BvhNode {
    vec4 minimum;
    vec4 maximum;
    uvec4 meta; // left, right, first triangle reference, triangle count
};

struct BrickHeader {
    uint nodeOffset;
    uint nodeCount;
    uint referenceOffset;
    uint referenceCount;
    vec4 volume; // rgb tint, alpha extinction density
};

struct TraversalConfig {
    uint headerOffset;
    uint brickSize;
    uint brickDimensionX;
    uint brickDimensionY;
    uint brickDimensionZ;
    uint rayMode;
    uint variantIndex;
    uint workloadMode; // 0 surface-only, 1 surface + sparse volume
};

struct DebugEvent {
    vec4 positionT;
    uvec4 data; // type, x/index, y/count, z/depth
};

layout(std430, binding = 0) readonly buffer TriangleBuffer {
    Triangle triangles[];
};

layout(std430, binding = 1) readonly buffer BvhBuffer {
    BvhNode bvhNodes[];
};

layout(std430, binding = 2) readonly buffer BvhReferenceBuffer {
    uint bvhTriangleReferences[];
};

layout(std430, binding = 3) readonly buffer BrickHeaderBuffer {
    BrickHeader brickHeaders[];
};

layout(std430, binding = 4) readonly buffer MicroBvhBuffer {
    BvhNode microBvhNodes[];
};

layout(std430, binding = 5) readonly buffer MicroReferenceBuffer {
